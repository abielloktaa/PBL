        let currentProduct = null;

        function openProductModal(card) {
            // Ambil data dari atribut data-*
            currentProduct = {
                id: card.dataset.id,
                name: card.dataset.name,
                depot: card.dataset.depot,
                price: parseInt(card.dataset.price),
                oldPrice: card.dataset.oldPrice,
                rating: card.dataset.rating,
                sold: card.dataset.sold,
                stock: card.dataset.stock,
                category: card.dataset.category,
                desc: card.dataset.desc,
                icon: card.dataset.icon,
                iconColor: card.dataset.iconColor,
                badge: card.dataset.badge,
            };

            // Isi konten modal
            document.getElementById('modalName').textContent = currentProduct.name;
            document.getElementById('modalDepot').textContent = currentProduct.depot;
            document.getElementById('modalCategory').textContent = currentProduct.category;
            document.getElementById('modalRating').textContent = currentProduct.rating;
            document.getElementById('modalSold').textContent = `(${currentProduct.sold} terjual)`;
            document.getElementById('modalStock').textContent = currentProduct.stock;
            document.getElementById('modalDesc').textContent = currentProduct.desc;
            document.getElementById('modalQty').value = 1;

            // Harga
            document.getElementById('modalPrice').textContent = 'Rp ' + currentProduct.price.toLocaleString('id-ID');
            const oldPriceEl = document.getElementById('modalOldPrice');
            if (currentProduct.oldPrice && currentProduct.oldPrice !== '') {
                oldPriceEl.textContent = 'Rp ' + parseInt(currentProduct.oldPrice).toLocaleString('id-ID');
                oldPriceEl.classList.remove('hidden');
            } else {
                oldPriceEl.classList.add('hidden');
            }

            // Icon
            const iconEl = document.getElementById('modalIcon');
            iconEl.className = `fa-solid ${currentProduct.icon} ${currentProduct.iconColor} text-8xl md:text-9xl opacity-70`;

            // Badge
            const badgeEl = document.getElementById('modalBadge');
            if (currentProduct.badge && currentProduct.badge !== '') {
                badgeEl.textContent = currentProduct.badge;
                badgeEl.classList.remove('hidden');
            } else {
                badgeEl.classList.add('hidden');
            }

            // Tampilkan modal
            const modal = document.getElementById('productModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.classList.add('modal-open');
        }

        function closeProductModal() {
            const modal = document.getElementById('productModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.classList.remove('modal-open');
            currentProduct = null;
        }

        function changeQty(delta) {
            const input = document.getElementById('modalQty');
            let val = parseInt(input.value) + delta;
            if (val < 1) val = 1;
            if (currentProduct && val > parseInt(currentProduct.stock)) {
                val = parseInt(currentProduct.stock);
                alert('Jumlah melebihi stok tersedia!');
            }
            input.value = val;
        }

        function addToCart() {
            if (!currentProduct) return;
            const qty = document.getElementById('modalQty').value;
            const total = currentProduct.price * qty;
            
            // TODO: Kirim ke backend via fetch/AJAX
            // fetch('tambah_keranjang.php', { method: 'POST', body: ... })
            
            alert(`✅ ${currentProduct.name}\nJumlah: ${qty}\nTotal: Rp ${total.toLocaleString('id-ID')}\n\nBerhasil ditambahkan ke keranjang!`);
            closeProductModal();
        }

        function buyNow() {
            if (!currentProduct) return;
            const qty = document.getElementById('modalQty').value;
            const total = currentProduct.price * qty;
            
            alert(`🛒 Beli Langsung:\n${currentProduct.name}\nJumlah: ${qty}\nTotal: Rp ${total.toLocaleString('id-ID')}\n\nLanjut ke checkout...`);
            
            // TODO: Redirect ke checkout
            // window.location.href = 'checkout.php?id=' + currentProduct.id + '&qty=' + qty;
        }

        // Tutup modal dengan tombol ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeProductModal();
        });
    </script>

